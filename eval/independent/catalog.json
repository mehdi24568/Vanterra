  "builtInScenarios": [
    {
      "id": "pump-bearing",
      "kind": "anomaly",
      "name": "Feed pump bearing degradation",
      "whatHappensPhysically": "Progressive mechanical wear in feed pump P-101 over ~90 s."
    },
    {
      "id": "cooling-fan",
      "kind": "anomaly",
      "name": "Cooling tower fan trip",
      "whatHappensPhysically": "The CT-401 fan trips; heat rejection collapses and propagates into the process."
    },
    {
      "id": "mcc-sag",
      "kind": "anomaly",
      "name": "MCC-520 supply voltage depression",
      "whatHappensPhysically": "A developing high-resistance joint at the MCC-520 incomer depresses bus voltage."
    },
    {
      "id": "reduced-rate",
      "kind": "normal",
      "name": "Throughput change to 70 %",
      "whatHappensPhysically": "Planned rate reduction. Baselines are re-learned; no anomalies are expected."
    },
    {
      "id": "full-rate",
      "kind": "normal",
      "name": "Throughput change to 100 %",
      "whatHappensPhysically": "Planned return to nominal rate. Baselines are re-learned; no anomalies are expected."
    },
    {
      "id": "pump-changeover",
      "kind": "normal",
      "name": "Feed pump duty changeover",
      "whatHappensPhysically": "Routine duty/standby swap between P-101 and P-102 (also a valid response to a P-101 problem)."
    },
    {
      "id": "clear-faults",
      "kind": "normal",
      "name": "Clear injected faults",
      "whatHappensPhysically": "Simulated repair: removes all injected faults and lets the process recover."
    },
    {
      "id": "ot-remote-access",
      "kind": "cyber",
      "name": "Suspicious remote engineering access",
      "whatHappensPhysically": "Repeated failed vendor logons on the jump host, then a remote session to the engineering workstation outside any approved window, a read of the cooling-plant controller, and an enterprise host reaching the HMI directly. No setting is changed."
    },
    {
      "id": "cp-fan-setpoint",
      "kind": "cyber_physical",
      "name": "Unapproved fan-speed change",
      "whatHappensPhysically": "A vendor account reaches the engineering workstation through the jump host outside any approved window and lowers the cooling-tower fan speed setpoint on PLC-500 to 35 %. The process responds to the new setting."
    },
    {
      "id": "cp-approved-tuning",
      "kind": "cyber_physical",
      "name": "Approved fan-drive tuning",
      "whatHappensPhysically": "The controls engineer applies approved change CHG-1042 from the engineering workstation inside its window, lowering the fan speed setpoint to 60 %. The change is authorised; its thermal effect on the process is still real."
    }
  ]
