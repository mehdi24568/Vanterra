# Project ATLAS - environment configuration.
#
# Copy the lines you need into .env.local (git-ignored) and restart `npm run dev`.
# Everything is optional: without any configuration the application runs fully
# offline, and only the AI review is unavailable.
#
# Variables WITHOUT the VITE_ prefix are read only by the Node server process
# (server/atlasAi.ts) and never reach the browser bundle. Never give an API key a
# VITE_ prefix: anything with that prefix is compiled into public JavaScript.

# ---------------------------------------------------------------- AI review (server side)

# Credential for the Claude API. Without it, AI review is reported as unavailable and
# everything else works as normal. ANTHROPIC_AUTH_TOKEN (bearer token) is accepted instead.
ANTHROPIC_API_KEY=

# anthropic (default) | none (switch AI review off)
# `scripted` selects a TEST DOUBLE that is not a language model; it is accepted only
# together with ATLAS_ALLOW_SCRIPTED_PROVIDER=1, and every screen and report it
# produces says so. It exists for tests and interface work.
ATLAS_LLM_PROVIDER=anthropic
# ATLAS_ALLOW_SCRIPTED_PROVIDER=1

# Claude model ID and effort (low | medium | high | xhigh | max).
ATLAS_LLM_MODEL=claude-opus-5-5
ATLAS_LLM_EFFORT=medium

# API endpoint. ANTHROPIC_BASE_URL in the environment is deliberately ignored, so a
# value set for another tool cannot silently redirect ATLAS's requests.
ATLAS_LLM_BASE_URL=https://api.anthropic.com

# Server-side refusal fallback (beta): default | off
ATLAS_LLM_REFUSAL_FALLBACK=default

# Bounds for one investigation: per model call, and for the whole five-agent run (seconds).
ATLAS_LLM_AGENT_TIMEOUT_S=90
ATLAS_LLM_RUN_DEADLINE_S=240

# Optional price override for the cost estimate, USD per million tokens. When unset,
# the built-in list-price table for the model is used; the result is labelled an estimate.
# ATLAS_LLM_PRICE_INPUT=4
# ATLAS_LLM_PRICE_OUTPUT=20

# ---------------------------------------------------------------- simulation (browser)

# Seed for the reproducible facility simulation (integer).
VITE_ATLAS_SEED=20260112

# Seconds of simulated history generated at start-up, so baselines are learned and
# trend charts are populated before the first frame.
VITE_ATLAS_PREROLL_S=120

# Rule-based reasoning provider used by the Intelligence Engine (the only one shipped).
VITE_ATLAS_REASONER=local
